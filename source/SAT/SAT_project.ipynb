        "                    home = t + 1\n",
        "                if is_true(model.evaluate(v[i][j][1][t])):\n",
        "                    away = t + 1\n",
        "            if home is not None and away is not None:\n",
        "                schedule[j][i] = f\"{home} ∨ {away}\"\n",
