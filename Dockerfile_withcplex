# Runtime Python API Setup Dockerfile
FROM --platform=linux/amd64 ubuntu:22.04

# Avoid interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    wget \
    build-essential \
    python3 \
    python3-pip \
    python3-dev \
    unzip \
    default-jre \
    && rm -rf /var/lib/apt/lists/*

# Install Pyomo and other Python packages
RUN pip3 install pyomo numpy pandas

# Copy CPLEX installer
COPY cplex_studio2211.linux_x86_64.bin /tmp/
RUN chmod +x /tmp/cplex_studio2211.linux_x86_64.bin

# Create response file for SILENT CPLEX installation
RUN echo "LICENSE_ACCEPTED=TRUE" > /tmp/cplex_response.rsp && \
    echo "USER_INSTALL_LANGUAGE=2" >> /tmp/cplex_response.rsp && \
    echo "USER_INSTALL_DIR=/opt/ibm/CPLEX_Studio2211" >> /tmp/cplex_response.rsp && \
    echo "CHOSEN_INSTALL_FEATURE_LIST=cplex,concert,cp_optimizer,opl" >> /tmp/cplex_response.rsp && \
    echo "LAUNCH_APPLICATION_AFTER_INSTALLATION=false" >> /tmp/cplex_response.rsp

# Install CPLEX silently (no user interaction needed)
RUN /tmp/cplex_studio2211.linux_x86_64.bin -f /tmp/cplex_response.rsp && \
    rm /tmp/cplex_studio2211.linux_x86_64.bin /tmp/cplex_response.rsp

# Set basic environment variables
ENV CPLEX_STUDIO_DIR=/opt/ibm/CPLEX_Studio2211
ENV CPLEX_HOME=$CPLEX_STUDIO_DIR/cplex

# Copy Python API setup script for RUNTIME execution
COPY setup_cplex_python.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/setup_cplex_python.sh

# Set working directory
WORKDIR /app

# Copy your MIP project
COPY MIP/ /app/

# Create startup script that sets up Python API then runs your code
RUN echo '#!/bin/bash' > /usr/local/bin/startup.sh && \
    echo 'echo "Setting up CPLEX Python API..."' >> /usr/local/bin/startup.sh && \
    echo 'setup_cplex_python.sh' >> /usr/local/bin/startup.sh && \
    echo 'echo "Python API setup complete. Running your application..."' >> /usr/local/bin/startup.sh && \
    echo 'exec "$@"' >> /usr/local/bin/startup.sh && \
    chmod +x /usr/local/bin/startup.sh

# Use startup script as entrypoint
ENTRYPOINT ["/usr/local/bin/startup.sh"]
CMD ["python3", "mip_model.py"]